/* Дополнительные стили для контактов */
.contact-methods {
    margin-top: 15px;
}

.contact-link {
    display: inline-block;
    color: #38bdf8;
    text-decoration: none;
    font-weight: 600;
    margin-bottom: 10px; /* Отступ между почтой и WhatsApp */
    font-size: 15px;
}

.contact-link:hover {
    text-decoration: underline;
}

.contact-link i {
    margin-right: 8px; /* Отступ от иконки до текста */
    font-size: 1.1em;
}

/* Изменение цвета иконки WhatsApp на брендовый */
.fa-whatsapp {
    color: #25D366;
}
